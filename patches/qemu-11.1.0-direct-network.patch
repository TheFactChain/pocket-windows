+#ifdef WIN32
+/* libslirp supplies native SOCKETs, not QEMU CRT socket descriptors. */
+#pragma push_macro("getsockopt")
+#pragma push_macro("setsockopt")
+#undef getsockopt
+#undef setsockopt
+static bool net_slirp_bind_interface(slirp_os_socket fd, uint32_t ifindex)
+{
+    WSAPROTOCOL_INFOA info;
+    int length = sizeof(info);
+    DWORD value = htonl(ifindex);
+
+    if (!ifindex) {
+        return true;
+    }
+    if (getsockopt(fd, SOL_SOCKET, SO_PROTOCOL_INFOA,
+                   (char *)&info, &length) == SOCKET_ERROR ||
+        info.iAddressFamily != AF_INET) {
+        return false;
+    }
+    return setsockopt(fd, IPPROTO_IP, IP_UNICAST_IF,
+                      (char *)&value, sizeof(value)) == 0;
+}
+#pragma pop_macro("setsockopt")
+#pragma pop_macro("getsockopt")
+
+#endif
