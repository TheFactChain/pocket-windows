+/* Picture update period in ms: the launcher's frame rate setting arrives as WCP_REFRESH_MS. */
+static int wcp_refresh_ms(void)
+{
+    static int period;
+
+    if (!period) {
+        const char *text = getenv("WCP_REFRESH_MS");
+        int value = text ? atoi(text) : 0;
+
+        period = value >= 4 && value <= GUI_REFRESH_INTERVAL_DEFAULT ? value : GUI_REFRESH_INTERVAL_DEFAULT;
+    }
+    return period;
+}
