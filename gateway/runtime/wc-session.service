[Unit]
Description=Windows Claude isolated connection session
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service
Before=network-pre.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/wc-gateway/session.py
WorkingDirectory=/usr/local/lib/wc-gateway
Environment=PYTHONUNBUFFERED=1
Restart=no
TimeoutStopSec=30
KillMode=control-group
UMask=0077
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
