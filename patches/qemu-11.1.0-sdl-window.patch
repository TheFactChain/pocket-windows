+/* Small aspect units avoid borders; large units need ordinary pixel rounding. */
+static void sdl2_window_client_size(int surface_w, int surface_h,
+                                   int max_w, int max_h, int *width, int *height)
+{
+    int a = surface_w, b = surface_h, unit_w, unit_h, units;
+
+    max_w = SDL_max(1, max_w);
+    max_h = SDL_max(1, max_h);
+    if (surface_w <= 0 || surface_h <= 0) {
+        *width = *height = 1;
+        return;
+    }
+    while (b) {
+        int remainder = a % b;
+        a = b;
+        b = remainder;
+    }
+    unit_w = surface_w / a;
+    unit_h = surface_h / a;
+    units = SDL_min(a, SDL_min(max_w / unit_w, max_h / unit_h));
+    if (units > 0 && unit_w <= 16 && unit_h <= 16) {
+        *width = unit_w * units;
+        *height = unit_h * units;
+    } else {
+        double scale = SDL_min(1.0, SDL_min((double)max_w / surface_w,
+                                          (double)max_h / surface_h));
+        *width = SDL_max(1, (int)(surface_w * scale));
+        *height = SDL_max(1, (int)(surface_h * scale));
     }
+}
 
