+    SDL_GetWindowSize(scon->real_window, &current_w, &current_h);
+    if (current_w != width || current_h != height) {
+        /* SDL updates its cached size and expected_resize before calling Win32. */
+        SDL_SetWindowSize(scon->real_window, width, height);
