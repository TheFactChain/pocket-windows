+    if (scon->opengl) {
+        SDL_GetWindowSize(scon->real_window, &max_x, &max_y);
+        max_x--;
+        max_y--;
+    } else {
+        float scale_x, scale_y;
+
+        SDL_RenderGetScale(scon->real_renderer, &scale_x, &scale_y);
+        if (scale_x <= 0 || scale_y <= 0) {
+            return true;
+        }
+        /* The last output pixel need not map to the last logical integer. */
+        max_x = surface_width(scon->surface) - SDL_max(1, (int)ceilf(1 / scale_x));
+        max_y = surface_height(scon->surface) - SDL_max(1, (int)ceilf(1 / scale_y));
+    }
+    return x <= 0 || y <= 0 || x >= max_x || y >= max_y;
